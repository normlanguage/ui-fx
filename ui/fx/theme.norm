package ui.fx

String theme() {
  "data:text/css," + """
.root {
  -fx-font-family: "Microsoft YaHei";
  -fx-font-size: 14px;
  -fx-background-color: #f4f6fb;
  -fx-accent: #5265dc;
  -fx-focus-color: #5265dc;
  -fx-faint-focus-color: transparent;
}
.label, .check-box { -fx-text-fill: #26334d; }
.norm-title { -fx-font-size: 30px; -fx-font-weight: bold; }
.norm-muted { -fx-text-fill: #748097; }
.norm-card {
  -fx-background-color: white;
  -fx-background-radius: 12px;
  -fx-border-color: #e4e9f2;
  -fx-border-radius: 12px;
  -fx-padding: 12px;
  -fx-alignment: center-left;
}
.button {
  -fx-background-color: white;
  -fx-text-fill: #42516b;
  -fx-background-radius: 8px;
  -fx-padding: 9px 16px;
  -fx-cursor: hand;
}
.button:hover { -fx-background-color: #e8edf8; }
.button.norm-primary { -fx-background-color: #5265dc; -fx-text-fill: white; }
.button.norm-primary:hover { -fx-background-color: #4253c6; }
.norm-destructive { -fx-text-fill: #c34d54; }
.text-field {
  -fx-background-color: white;
  -fx-background-radius: 8px;
  -fx-border-color: #dce2ee;
  -fx-border-radius: 8px;
  -fx-padding: 10px 12px;
  -fx-prompt-text-fill: #96a0b4;
}
.text-field:focused { -fx-border-color: #5265dc; }
.scroll-pane, .scroll-pane > .viewport { -fx-background-color: transparent; }
.scroll-pane { -fx-padding: 2px; }
.check-box { -fx-padding: 8px 4px; }
.check-box .box { -fx-background-radius: 5px; -fx-border-radius: 5px; }

"""
}
