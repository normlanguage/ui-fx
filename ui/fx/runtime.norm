package ui.fx

import std.concurrent.completion
import std.core.Exception
import std.core.Unit
import std.context.currentContext
import std.context.withContext
import fx.graphics.platformStartup
import fx.graphics.platformExit
import fx.graphics.platformSetImplicitExit
import fx.graphics.platformIsFxApplicationThread

class FxRuntime {}

public Void withFxRuntime(Function<Void()> action) {
  if currentContext<FxRuntime>() != null { action() return }
  if platformIsFxApplicationThread() { throw Exception(message: "GUI runtime requires a non-UI thread") }
  var ready = completion<Unit>()
  var task = ready.task()
  try {
    platformStartup(() {
      try {
        platformSetImplicitExit(false)
        ready.succeed(Unit.Value)
      } catch Exception error { ready.fail(error) }
    })
    task.await()
    withContext<FxRuntime>(value: FxRuntime(), action: action)
  } finally {
    platformExit()
    ready.close()
  }
}

Void checkFxThread() {
  if !platformIsFxApplicationThread() { throw Exception(message: "GUI operation requires the UI thread") }
}
